{
  "name": "mod-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src vite.config.ts vitest.config.ts playwright.config.ts --max-warnings 0",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\"",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit --incremental false",
    "test": "vitest run",
    "build:visual": "pnpm run typecheck && vite build --mode visual",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.9.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "20.14.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.12",
    "vitest": "5.0.0",
    "vue-tsc": "^3.1.1"
  }
}
