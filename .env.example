MOD_ENV=development
MOD_HOST=127.0.0.1
MOD_PORT=8100
# Database connection. Real values live only in the run host's local env
# files (.env.systemd / .env.local, both gitignored). Never commit real
# credentials to the repository. This example uses placeholders only.
MOD_DB_HOST=127.0.0.1
MOD_DB_PORT=3306
MOD_DB_NAME=mod_s_v2
MOD_DB_USER=
MOD_DB_PASSWORD=
MOD_DB_POOL_SIZE=10
MOD_DB_MAX_OVERFLOW=20
MOD_DISPLAY_TIMEZONE=Asia/Hong_Kong

# Optional BI read account (falls back to MOD_DB_* if unset).
MOD_BI_DB_USER=
MOD_BI_DB_PASSWORD=

# Fallback snapshot path override (defaults to a bundled snapshot when unset).
MOD_FALLBACK_SNAPSHOT_PATH=

# Read-only in-memory dashboard projection. It never writes business data.
MOD_LIVE_PROJECTION_ENABLED=true

# Write-capable simulator is always opt-in and requires a separate write URL.
MOD_SIMULATOR_ENABLED=false
MOD_DB_WRITE_URL=

# Business simulation engine (Step 1 technology verification, default closed)
MOD_SIMULATION_ENGINE_ENABLED=false

# Optional AI features are fail-closed. Required values must all be set to enable them.
MOD_CF_AI_ENABLED=false
MOD_CF_AI_GATEWAY_URL=
MOD_CF_AI_DAILY_LIMIT=100
MOD_CF_AI_CACHE_TTL_SECONDS=60
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# HeatWave AutoML feature toggle (fail-closed).
MOD_HW_ML_ENABLED=false
# HeatWave AutoML model catalog schema name (DB-user derived); leave empty to skip native catalog.
MOD_HW_ML_SCHEMA=
