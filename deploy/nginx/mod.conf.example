# Nginx template for the MOD dashboard host.
# Copy to mod.conf and replace __PUBLIC_DOMAIN__ with the real domain at deploy time.
# The real mod.conf is gitignored (carries real domain and cert paths).

# HTTP -> HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name __PUBLIC_DOMAIN__;
    server_tokens off;
    return 301 https://__PUBLIC_DOMAIN__$request_uri;
}

# Primary host
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __PUBLIC_DOMAIN__;
    server_tokens off;

    include /etc/nginx/snippets/cloudflare-realip.conf;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_DOMAIN__/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; preload" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;

    # 硬拦截：AI/LLM 训练爬虫与检索爬虫，按 User-Agent 直接 403，连内容都不返回。
    # robots.txt 只是君子协定；这里是强制层。内部交流系统，谢绝一切采集。
    if ($http_user_agent ~* "(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai|Google-Extended|GoogleOther|PerplexityBot|Perplexity-User|CCBot|Bytespider|Amazonbot|Applebot-Extended|Meta-ExternalAgent|FacebookBot|cohere-ai|Diffbot|ImagesiftBot|Timpibot|Omgilibot|YouBot|Baiduspider|YandexBot|Sogou|360Spider|DotBot|MJ12bot|AhrefsBot|SemrushBot|DataForSeoBot)") {
        return 403;
    }

    location = /robots.txt {
        default_type text/plain;
        return 200 "# 本站为内部交流系统，谢绝一切检索、抓取、索引与 AI 训练采集。\nUser-agent: *\nDisallow: /\n";
    }

    location = /api/v2/live-projection/events {
        proxy_pass http://127.0.0.1:8100/api/v2/live-projection/events;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        add_header Cache-Control "no-cache, no-transform" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8100/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
        limit_req zone=general burst=20 nodelay;
    }

    location / {
        root /home/ubuntu/mod/frontend/dist;
        try_files $uri $uri/ /index.html;
        add_header Strict-Transport-Security "max-age=31536000; preload" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
        limit_req zone=general burst=20 nodelay;
    }
}
