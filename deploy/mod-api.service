[Unit]
Description=MOD API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${MOD_PROJECT_ROOT}/backend/current
EnvironmentFile=${MOD_PROJECT_ROOT}/.env.api.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=${MOD_PROJECT_ROOT}/backend/current
Environment=MOD_SIMULATOR_STATUS_PATH=${MOD_PROJECT_ROOT}/output/simulator_status.json
ExecStart=${MOD_PROJECT_ROOT}/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
