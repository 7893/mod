[Unit]
Description=MOD API Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/mod/backend/current
EnvironmentFile=/home/ubuntu/mod/.env.api.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/mod/backend/current
Environment=MOD_SIMULATOR_STATUS_PATH=/home/ubuntu/mod/output/simulator_status.json
ExecStart=/home/ubuntu/mod/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --proxy-headers
Restart=always
RestartSec=5
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
