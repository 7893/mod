[Unit]
Description=MOD Realistic Business Simulation Engine Service
After=network-online.target mod-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${MOD_PROJECT_ROOT}
EnvironmentFile=${MOD_PROJECT_ROOT}/.env.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=${MOD_PROJECT_ROOT}/backend/.venv/bin/python ${MOD_PROJECT_ROOT}/scripts/agy/run_simulator_service.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
