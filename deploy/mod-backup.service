[Unit]
Description=MOD Daily Disaster Recovery Backup Service (Logical Dump, Encryption, S3 Sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/mod
EnvironmentFile=/home/ubuntu/mod/.env.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/mod/backend/.venv/bin/python /home/ubuntu/mod/scripts/ops/backup_pipeline.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
