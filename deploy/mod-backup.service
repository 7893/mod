[Unit]
Description=MOD Daily Disaster Recovery Backup Service (Logical Dump, Encryption, S3/R2 Sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mod/backend/current
EnvironmentFile=/home/ubuntu/mod/.env.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/mod/backend/current
Environment=PATH=/home/ubuntu/mod/backend/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ubuntu/mod/backend/.venv/bin/python /home/ubuntu/mod/backend/current/scripts/ops/backup_pipeline.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
