[Unit]
Description=MOD Daily Command Briefing Generation Service (LLM via mod-gateway)
After=network-online.target mod-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/mod
EnvironmentFile=/home/ubuntu/mod/.env.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/mod/backend/.venv/bin/python /home/ubuntu/mod/scripts/kiro/run_daily_briefing.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
