[Unit]
Description=MOD Daily Command Briefing Generation Service (LLM via mod-gateway)
After=network-online.target mod-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=${MOD_PROJECT_ROOT}
EnvironmentFile=${MOD_PROJECT_ROOT}/.env.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=${MOD_PROJECT_ROOT}/backend/.venv/bin/python ${MOD_PROJECT_ROOT}/scripts/kiro/run_daily_briefing.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
