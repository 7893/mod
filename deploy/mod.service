# Template: render with scripts/project/render_deploy_config.py before installation.
[Unit]
Description=MOD Unified Core Service (API Gateway + Simulation Engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=__ENV_FILE__
User=__RUN_USER__
WorkingDirectory=__PROJECT_ROOT__
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=MOD_DEMO_MODE=__DEMO_MODE__
Environment=PYTHONPATH=__PROJECT_ROOT__/backend:__PROJECT_ROOT__
ExecStart=/usr/bin/env MOD_DEMO_MODE=__DEMO_MODE__ PYTHONPATH=__PROJECT_ROOT__/backend:__PROJECT_ROOT__ __PYTHON__ __PROJECT_ROOT__/scripts/project/run_unified.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
