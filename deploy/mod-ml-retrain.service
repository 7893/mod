[Unit]
Description=MOD HeatWave AutoML Daily Retraining and Verification Service
After=network-online.target mod-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=${MOD_PROJECT_ROOT}
EnvironmentFile=${MOD_PROJECT_ROOT}/.env.systemd
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=${MOD_PROJECT_ROOT}/backend/.venv/bin/python ${MOD_PROJECT_ROOT}/scripts/agy/run_ml_retrain.py --once --run-type scheduled
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
